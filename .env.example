# ============================================================
# RESSOAR — copie este arquivo para .env e preencha.
#   cp .env.example .env
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# ============================================================

# --- Supabase (banco + login + funções) ---
# Painel do Supabase > Project Settings > General > Reference ID
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
# Painel do Supabase > Account > Access Tokens > Generate new token
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Project Settings > API > anon public  (pode aparecer no navegador, é pública)
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Project Settings > API > service_role  (SEGREDO — só no servidor/scripts)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare (hospedagem do painel) ---
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ActiveCampaign (só para a migração inicial; pode deixar vazio depois) ---
AC_API_URL=https://SUACONTA.api-us1.com
AC_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Canal transacional (códigos de segurança do login) ---
# URL do webhook no n8n (ou outro serviço) que recebe {segredo, para, assunto, html}
RESSOAR_EMAIL_WEBHOOK=https://seu-n8n.com.br/webhook/ressoa/transacional
# Senha combinada entre a Edge Function e o webhook — invente uma longa
RESSOAR_EMAIL_SEGREDO=troque-por-uma-frase-longa-e-aleatoria

# --- Provedor de envio em massa (quando ligar o envio real) ---
# Resend: a chave também pode ser colada direto em Configurações, no painel.
RESEND_API_KEY=

# Amazon SES: estas três viram secrets da Edge Function `enviar-ses` — as chaves
# da AWS nunca ficam no banco. Deixe vazio enquanto não migrar para o SES.
# IAM > Users > (usuário só de envio) > Security credentials > Access keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGIAO=us-east-1
# Frase combinada entre o motor e a função de envio. A MESMA precisa ser salva
# em Configurações > Segredo interno do SES. Invente uma longa.
SES_SEGREDO=

# --- Planilhas do Google ---
# O cadastro do Ressoar no Google, feito UMA vez por quem instala. É ele
# que faz a tela do Google dizer "Prosseguir para <o nome do cadastro>" —
# quem usa o painel só clica em Conectar conta Google e escolhe a conta;
# nunca vê estas duas linhas.
# console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth
# (tipo Aplicativo da Web). Viram secrets da Edge Function `google-sheets`.
# ATENÇÃO: a tela de consentimento precisa estar "Em produção". Parada
# "Em teste", o Google mata a conexão a cada 7 dias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Assinatura da instalação (opcional) ---
# Quem assina: aparece na aba do navegador, no rodapé da barra lateral, na tela
# de entrada e no cabeçalho dos e-mails de conta. Preencha AQUI: o instalador
# leva o valor para o painel (app/painel/.env.local, porque o Vite só entrega ao
# navegador o que começa com VITE_) e para a Edge Function conta-email (secret
# MARCA_NOME). Vazias, tudo se apresenta só como Ressoar — nome de ninguém.
# Valor com espaço precisa de ASPAS DUPLAS (ex.: VITE_MARCA_NOME="Fulana de
# Tal"): o instalador do Linux/Mac lê este arquivo com `source`, e sem
# aspas o bash tenta executar as palavras depois da primeira.
VITE_MARCA_NOME=""
VITE_MARCA_RODAPE=""
